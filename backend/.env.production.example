# Backend production environment
NODE_ENV=production
PORT=6321
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/audio-guest-book

# Comma-separated list of allowed browser origins (include www if it resolves)
FRONTEND_URL=https://mouadhattia.xyz,https://www.mouadhattia.xyz

# Shared secret for the Raspberry Pi phone button. Token-based, not IP-based,
# so it survives the Pi's 5G IP changing. Generate with:
#   openssl rand -hex 24
PI_SHARED_TOKEN=<generate-a-long-random-secret>
