# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server port (default: 5000)
PORT=5000

# MongoDB connection string
# Local: mongodb://localhost:27017/audio-guest-book
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/audio-guest-book
MONGO_URI=mongodb://localhost:27017/audio-guest-book

# Frontend URL for CORS (adjust if your frontend runs on a different port)
FRONTEND_URL=http://localhost:3000

# Shared secret the Raspberry Pi phone-button client must present to connect
# over Socket.IO. Leave blank to allow unauthenticated connections (fine for
# a trusted local network, not recommended if the backend is public).
PI_SHARED_TOKEN=
