# Audio Guest Book backend URL (the Node/Express server, not the frontend)
SERVER_URL=http://192.168.1.50:5000

# Must match PI_SHARED_TOKEN in backend/.env on the server. Leave blank only
# if the server's PI_SHARED_TOKEN is also blank.
PI_SHARED_TOKEN=

# BCM GPIO pin number the button is wired to
BUTTON_GPIO_PIN=17

# Debounce window in milliseconds (ignores extra bounces from a mechanical switch)
BUTTON_BOUNCE_MS=300

# true if the button wires the pin to GND when pressed (uses internal pull-up).
# false if it wires the pin to 3.3V when pressed (uses internal pull-down).
BUTTON_PULL_UP=true

# Set to true to run without any GPIO hardware: press Enter in the terminal
# to simulate a button press. Useful for testing on a laptop before wiring
# up the real Raspberry Pi + button.
SIMULATE=false
