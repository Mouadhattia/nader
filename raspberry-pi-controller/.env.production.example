# Raspberry Pi phone button — PRODUCTION config
# Copy to .env on the Pi:  cp .env.production.example .env

# Public backend URL. https:// works over 5G from anywhere — the Pi makes an
# OUTBOUND connection, so its changing 5G IP never needs to be known or
# allowlisted, and no port forwarding is required on the 5G side.
SERVER_URL=https://api.mouadhattia.xyz

# Must match PI_SHARED_TOKEN in backend/.env.production on the server.
# This is what authorises the Pi instead of an IP allowlist.
PI_SHARED_TOKEN=27a723dfba9bd408b388cfc751e0a92aed0ce65f1330375f

# BCM GPIO pin number the button is wired to
BUTTON_GPIO_PIN=17

# Debounce window in milliseconds
BUTTON_BOUNCE_MS=300

# true if the button wires the pin to GND when pressed (internal pull-up)
BUTTON_PULL_UP=true

# Must be false on the real Pi so it reads the GPIO button instead of stdin
SIMULATE=false
